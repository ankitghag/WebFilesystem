# API Settings
#10081 = 7days
API_V1_STR=/api/v1
SECRET_KEY=secure_string_by_USER
ACCESS_TOKEN_EXPIRE_MINUTES=10081
REFRESH_TOKEN_EXPIRE_MINUTES=10081
ALGORITHM=HS256
JWT_AUDIENCE=*
JWT_ISSUER=http://localhost:8000
USERDATABASE_URL=Postgresql database url
LOG_LEVEL=INFO
aws_access_key_id=cloudfare access keyid
aws_secret_key=cloudfare secret key
s3api=cloudfare R2 storage or aws S3 url
redis_url=redis aws url or redis provider
obj_bucket=BUCKET NAME that stre file object
